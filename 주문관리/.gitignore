# ==========================================================
# Git이 절대 추적하면 안 되는 파일들
# ----------------------------------------------------------
# .env 에는 실제 API 키가 들어갑니다. 절대 git에 올리면 안 됩니다.
# *.db 는 고객 개인정보(이름/전화번호/통관고유부호)가 담긴 실제 데이터베이스입니다.
# ==========================================================

# 비밀키 파일
.env

# 데이터베이스 파일 (고객 개인정보 포함)
*.db
*.db-journal
*.sqlite
*.sqlite3

# 파이썬 캐시
__pycache__/
*.pyc

# 가상환경
.venv/
venv/

# 로그 파일
*.log

# OS 파일
.DS_Store
Thumbs.db
