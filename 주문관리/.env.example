# ==========================================================
# 환경변수 예시 파일 (.env.example)
# ----------------------------------------------------------
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤,
# 아래 값들을 실제 발급받은 키로 바꿔서 사용하세요.
#
#   복사 방법 (Windows 명령 프롬프트):
#       copy .env.example .env
#
# .env 파일은 절대 다른 사람에게 공유하거나 git에 올리지 마세요.
# ==========================================================

# 실행 모드: mock(가상 데이터) 또는 real(실제 쿠팡 API)
# 처음에는 mock으로 두고 테스트하세요.
APP_MODE=mock

# 쿠팡 Wing 오픈API 정보 (실제 모드에서만 필요, 아직 없어도 됨)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 관세청 유니패스 오픈API 인증키 (추후 공식 통관검증 연동 시 필요)
UNIPASS_API_KEY=

# ----------------------------------------------------------
# Supabase(클라우드 PostgreSQL) 연결 문자열
# ----------------------------------------------------------
# 비워두면 예전처럼 로컬 파일(order_management.db)을 씁니다.
# 채우면 그 대신 Supabase에 저장/조회합니다(여러 컴퓨터에서 같은 데이터 공유).
# Supabase 대시보드 → Settings → Database → Connection string(URI 탭) 값을 붙여넣으세요.
# 예: DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
