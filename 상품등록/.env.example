# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요.  (cp .env.example .env)
# .env 는 절대 깃에 올리지 마세요 (.gitignore 에 포함됨).

# Supabase 연결 문자열 (별도 프로젝트)
# 대시보드 → Settings → Database → Connection string → URI 값을 그대로 붙여넣기
# 예) postgresql://postgres.xxxx:비밀번호@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# (선택) 네이버 검색광고 API — AI 소싱의 월간검색수·경쟁도 표시에 사용(무료 발급)
# 네이버 검색광고(searchad.naver.com) → 도구 → API 사용관리 에서 발급
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=
